{
  "name": "pyotobaslat",
  "displayName": "PyOtoBaşlat - Türkçe Python Sihirbazı",
  "description": "Python projelerini tek tuşla kurar, venv oluşturur, hataları Türkçeleştirir, otomatik düzeltir, görsel performans analizi yapar, .env sihirbazı sunar, güvenlik taraması, proje sağlık kontrolü, test çalıştırıcı ve kod kalitesi analizi yapar.",
  "version": "2.1.4",
  "publisher": "Lionapp1",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lionapp1/pyotobaslat"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Testing",
    "Linters"
  ],
  "keywords": [
    "python",
    "turkish",
    "venv",
    "auto-fix",
    "self-healing",
    "django",
    "flask",
    "fastapi"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyotobaslat.hazirlaVeCalistir",
        "title": "🐍 PyOtoBaşlat: Projeyi Hazırla ve Çalıştır",
        "icon": "$(play)"
      },
      {
        "command": "pyotobaslat.performansAnalizi",
        "title": "⚡ PyOtoBaşlat: Görsel Performans Analizi",
        "icon": "$(graph)"
      },
      {
        "command": "pyotobaslat.paketleriGuncelle",
        "title": "📦 PyOtoBaşlat: Eksik Paketleri Kur",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pyotobaslat.guvenlikTaramasi",
        "title": "🔒 PyOtoBaşlat: Güvenlik Açığı Tara",
        "icon": "$(shield)"
      },
      {
        "command": "pyotobaslat.projeSaglikKontrolu",
        "title": "🏥 PyOtoBaşlat: Proje Sağlık Kontrolü",
        "icon": "$(pulse)"
      },
      {
        "command": "pyotobaslat.testleriCalistir",
        "title": "🧪 PyOtoBaşlat: Testleri Çalıştır",
        "icon": "$(beaker)"
      },
      {
        "command": "pyotobaslat.kodKalitesi",
        "title": "✨ PyOtoBaşlat: Kod Kalitesi Kontrolü",
        "icon": "$(sparkle)"
      },
      {
        "command": "pyotobaslat.hataIstatistikleri",
        "title": "📊 PyOtoBaşlat: Hata İstatistikleri",
        "icon": "$(pie-chart)"
      },
      {
        "command": "pyotobaslat.ortamiTemizle",
        "title": "🧹 PyOtoBaşlat: Ortamı Temizle",
        "icon": "$(trash)"
      },
      {
        "command": "pyotobaslat.ayarlarAc",
        "title": "⚙️ PyOtoBaşlat: Ayarları Aç",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pyotobaslat.hazirlaVeCalistir",
          "group": "navigation@1",
          "when": "editorLangId == python"
        },
        {
          "command": "pyotobaslat.guvenlikTaramasi",
          "group": "navigation@2",
          "when": "editorLangId == python"
        },
        {
          "command": "pyotobaslat.projeSaglikKontrolu",
          "group": "navigation@3",
          "when": "editorLangId == python"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pyotobaslat.hazirlaVeCalistir",
        "key": "f5",
        "when": "editorLangId == python"
      },
      {
        "command": "pyotobaslat.performansAnalizi",
        "key": "ctrl+shift+f5",
        "when": "editorLangId == python"
      },
      {
        "command": "pyotobaslat.guvenlikTaramasi",
        "key": "ctrl+shift+s",
        "when": "editorLangId == python"
      },
      {
        "command": "pyotobaslat.projeSaglikKontrolu",
        "key": "ctrl+shift+h",
        "when": "editorLangId == python"
      },
      {
        "command": "pyotobaslat.testleriCalistir",
        "key": "ctrl+shift+t",
        "when": "editorLangId == python"
      }
    ],
    "configuration": {
      "title": "🐍 PyOtoBaşlat Ayarları",
      "properties": {
        "pyotobaslat.otomatikKurulum": {
          "type": "boolean",
          "default": true,
          "description": "requirements.txt varsa otomatik kurar."
        },
        "pyotobaslat.venvOtomatikOlustur": {
          "type": "boolean",
          "default": true,
          "description": ".venv yoksa otomatik oluşturur."
        },
        "pyotobaslat.hataCevirmeniAktif": {
          "type": "boolean",
          "default": true,
          "description": "Hataları Türkçeleştirir."
        },
        "pyotobaslat.calistirmaModu": {
          "type": "string",
          "enum": [
            "otomatik",
            "django",
            "flask",
            "fastapi",
            "script"
          ],
          "default": "otomatik",
          "description": "Çalıştırma modu."
        },
        "pyotobaslat.otomatikPaketKontrol": {
          "type": "boolean",
          "default": true,
          "description": "Derin tarama ile eksik modülleri bulur."
        },
        "pyotobaslat.envSihirbaziAktif": {
          "type": "boolean",
          "default": true,
          "description": ".env şablonu oluşturur."
        },
        "pyotobaslat.selfHealingAktif": {
          "type": "boolean",
          "default": true,
          "description": "Build/pip/import hatalarını otomatik düzeltir."
        },
        "pyotobaslat.hataIstatistikleriKaydet": {
          "type": "boolean",
          "default": true,
          "description": "Hata istatistiklerini yerel olarak saklar."
        },
        "pyotobaslat.ozelPipKaynagi": {
          "type": "string",
          "default": "",
          "description": "Özel PyPI mirror URL'si (kurumsal ağlar için)."
        },
        "pyotobaslat.kodKalitesiAraci": {
          "type": "string",
          "enum": [
            "pylint",
            "flake8",
            "ruff"
          ],
          "default": "ruff",
          "description": "Kod kalitesi kontrol aracı."
        },
        "pyotobaslat.testCalistirici": {
          "type": "string",
          "enum": [
            "pytest",
            "unittest"
          ],
          "default": "pytest",
          "description": "Test çalıştırma aracı."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out *.vsix"
  },
  "files": [
    "out/**",
    "package.json",
    "icon.png"
  ],
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
